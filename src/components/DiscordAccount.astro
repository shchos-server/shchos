---
const { locale = "uk" } = Astro.props;
const english = locale === "en";
---
<div class="discord-account" data-discord-account data-locale={locale}>
  <a data-login href={`/api/auth/discord?locale=${locale}`}>
    {english ? "Sign in with Discord" : "Увійти через Discord"}
  </a>
  <span data-profile hidden>
    <span data-name></span>
    <span data-admin hidden>{english ? "Administrator" : "Адміністратор"}</span>
  </span>
  <button data-logout type="button" hidden>{english ? "Sign out" : "Вийти"}</button>
  <span class="status" data-auth-status role="status" aria-live="polite"></span>
</div>

<script src="../scripts/auth.js"></script>

<style>
  .discord-account { display: flex; align-items: center; justify-content: flex-end; flex-wrap: wrap; gap: 8px; font-size: 14px; }
  a, button { padding: 8px 12px; border-radius: 8px; color: #fff; background: #4752c4; font: inherit; text-decoration: none; }
  a:hover, button:hover { background: #5865f2; }
  a:focus-visible, button:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
  [data-name] { overflow-wrap: anywhere; }
  [data-admin] { margin-left: 6px; font-size: 12px; color: #bdc5ff; }
  .status { flex-basis: 100%; max-width: 300px; color: #d5d7e0; font-size: 12px; }
  .status:empty { display: none; }
  [hidden] { display: none !important; }
</style>
