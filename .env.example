# Set these in Netlify environment variables with the Functions scope.
# For local development copy to .env and use http://localhost:8888.
SITE_URL=https://your-site.netlify.app
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
# Optional: comma-separated role IDs that may also review reports.
# The server owner and members with Administrator permission already qualify.
DISCORD_ADMIN_ROLE_IDS=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
